# Copy this file to ".env" and fill in the values (".env" is never uploaded to GitHub).
# These values are not secret: they only say which Sanity project the dashboard opens.

# From sanity.io/manage → your project → Project ID
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Dashboard address: https://<this>.sanity.studio
SANITY_STUDIO_HOST=mercyseatchapel

# Website address used by the Preview tab to load the site's styles
SANITY_STUDIO_SITE_URL=https://akorsoftdesigns.github.io/Mercy-Seat-Chapel/

# Optional safety rails (comma-separated sign-in emails). Empty = every Administrator.
# Who sees Publish / Unpublish / Delete:
SANITY_STUDIO_PUBLISHERS=
# Who can change Site Settings (phone, email, links, giving page):
SANITY_STUDIO_SETTINGS_EDITORS=
